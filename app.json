{
  "expo": {
    "name": "Repeat That",
    "slug": "repeat-that",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "repeat-that",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.readthat",
      "supportsTablet": true
    },
    "android": {
      "package": "com.readthat",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCF8E8"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FCF8E8"
        }
      ],
      "expo-audio",
      "expo-asset"
    ]
  }
}
